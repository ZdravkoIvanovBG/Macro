{
  "name": "micro",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.4",
    "expo-font": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:bundle": "expo export --platform ios --output-dir .expo-export-check --clear",
    "check:calc": "node scripts/check-calc.mts",
    "check:sql": "node scripts/check-sql.mts",
    "check": "npm run typecheck && npm run check:calc && npm run check:sql && npm run check:stats && npm run check:off -- --offline && npm run check:deepl && npm run check:ingredients && npm run check:ingredient-names && npm run check:product-indicators",
    "check:off": "node --import ./scripts/register-ts.mjs scripts/check-off.mts",
    "check:stats": "node --import ./scripts/register-ts.mjs scripts/check-stats.mts",
    "check:deepl": "node --import ./scripts/register-ts.mjs scripts/check-deepl.mts",
    "check:ingredients": "node --import ./scripts/register-ts.mjs scripts/check-ingredients.mts",
    "check:ingredient-names": "node --import ./scripts/register-ts.mjs scripts/check-ingredient-names.mts",
    "check:product-indicators": "node --import ./scripts/register-ts.mjs scripts/check-product-indicators.mts"
  },
  "private": true
}
