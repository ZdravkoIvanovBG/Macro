{
  "name": "micro",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.19",
    "expo-camera": "~57.0.4",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:bundle": "expo export --platform ios --output-dir .expo-export-check --clear",
    "check:calc": "node scripts/check-calc.mts",
    "check:sql": "node scripts/check-sql.mts",
    "check": "npm run typecheck && npm run check:calc && npm run check:sql && npm run check:off -- --offline",
    "check:off": "node scripts/check-off.mts"
  },
  "private": true
}
