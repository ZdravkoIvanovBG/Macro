# Copy this file to .env and fill in your own key — .env is gitignored and
# must never be committed.

# DeepL API Free key (deepl.com -> sign up for the Free plan -> Account ->
# Authentication Key). Used only as a last-resort translation fallback for
# the ingredient scanner, when Open Food Facts has no ingredient text in
# either app language. Leave unset to disable this fallback; the scanner
# still works, it just shows whatever language OFF has for that product.
EXPO_PUBLIC_DEEPL_API_KEY=
